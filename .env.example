# Mapbox — map, directions, address and place search (required)
# Get a public token at https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Upstash Redis — shared storage for police reports (optional)
# Without it reports are kept in process memory: fine for `next dev` or one self-hosted
# Node process, but not shared between serverless instances (e.g. Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Open Charge Map — charger power and connectors in "Charging" search (optional; free key at
# https://openchargemap.org/profile/applications). Without it chargers come from Mapbox search.
OPEN_CHARGE_MAP_KEY=

# PostHog — analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Usage alert emails for /admin via inbound.new (optional)
INBOUND_API_KEY=
EMAIL_FROM=

# /admin usage dashboard (optional; admin API is disabled without ADMIN_SECRET)
ADMIN_SECRET=
ALERT_EMAIL=
APP_URL=
